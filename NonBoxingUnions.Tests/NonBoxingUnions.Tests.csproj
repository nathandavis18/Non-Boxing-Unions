<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GeneratorTests\VerifiedOutput\*.verified.cs" />
    <None Include="GeneratorTests\VerifiedOutput\*.verified.cs" />
    <None Update="GeneratorTests\VerifiedOutput\*.verified.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NuGet.Packaging" Version="8.0.0" />
    <PackageReference Include="NuGet.Protocol" Version="8.0.0" />
    <PackageReference Include="NuGet.Resolver" Version="8.0.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NonBoxingUnions\NonBoxingUnions.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="True" />
    <ProjectReference Include="..\NonBoxingUnions.CodeFixProviders\NonBoxingUnions.CodeFixProviders.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="True" />
  </ItemGroup>

</Project>